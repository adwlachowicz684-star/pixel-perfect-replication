__pycache__/
*.pyc
.DS_Store

# 🔑 第一百一十七轮：**回归产物不得入库**
#    🔴 根因（第九十八轮起反复出现）：run_all_gates 跑 chaos 会写 work/chaos_g341/，
#       G383 写 ledger/_audit_all_last.json —— **门禁自己会写文件** → 每次回归后索引必脏
#       → G400 报"基准已变"、G391 报"本地≠远端"，需要人工跑 audit-history 追。
#    ✅ 治本：work/ 整体不入库（它每次跑都重写，入库只会让基准永远追不上）。
#    🔑 判据：**每次跑都被重写的东西不是"内容"，是"产物"** —— 产物不该进版本管理。
work/

# 🔑 第一百一十八轮：**自测临时目录**（第三道防线）
#    🔴 根因：清理写在 `finally:` 里，进程被杀时不执行 → 残留被 `git add -A` 收进索引。
#    ✅ 即便残留没清掉，被 gitignore 后 `git add -A` 也**收不进去** —— 这才是根治。
#    🔑 自测需要 git 索引它时用 `git add -f` **显式强制**，与 gitignore 不冲突。
_selftest_tmp/

# 🔑 第一百二十九轮：**回归日志也是产物**（work/ 之后的第二例）。
#    🔴 真实事故：本轮把回归输出重定向到仓库根目录 `reg129.log` / `reg129b.log`，
#       随后 `git add -A` 把它们**收进索引并推上了远端** ——
#       🔑 与 117 轮 work/ 同源：**每次跑都被重写的东西不是内容，是产物**。
#    🔑 判据：产物应落在 work/（已忽略）或仓库外，不要重定向到仓库根目录。
*.log

# 🔑 第一百三十八轮：**变异体副本**（G428 哑门禁扫描用）。
#    🔴 真实事故：第一版把变异体写回 push_api.py 本身 → 文件字节错位写坏
#       （第 4479 行两段文本错位成 SyntaxError），而"恢复"已失去参照。
#    ✅ 改为写临时副本 scripts/_mutant_138.py，原文件全程不动；
#       副本若因进程被杀残留，被 gitignore 后 `git add -A` 也收不进去（118 轮③）。
scripts/_mutant_138.py
